<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AoS2.Backend</RootNamespace>
    <!-- Lokale Zugangsdaten (Discord-Secret) liegen in "dotnet user-secrets", nie im Repo. Siehe docs/backend.md. -->
    <UserSecretsId>aos2-backend-6f3c1e2a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AoS2.Backend.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Erreichbarkeitsprüfung der Spielserver (UDP-Abfrage wie im Spiel, siehe Servers/ServerProbe.cs). -->
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\AoS2.Contracts\AoS2.Contracts.csproj" />
    <ProjectReference Include="..\..\libs\AoS2.JoinTickets\AoS2.JoinTickets.csproj" />
    <ProjectReference Include="..\..\libs\AoS2.Shared\AoS2.Shared.csproj" />
  </ItemGroup>

</Project>
