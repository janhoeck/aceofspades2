<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AoS2.Launcher.ViewModels"
        xmlns:c="using:AoS2.Launcher.Controls"
        x:Class="AoS2.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Ace of Spades 2"
        Width="960" Height="560"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        Background="{StaticResource Night}"
        Foreground="{StaticResource Sand}"
        FontFamily="{StaticResource BodyFont}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseSettingsCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="TextBlock.status">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.detail">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{StaticResource SandMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Hint}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.hint.warning">
      <Setter Property="Foreground" Value="{StaticResource CoralText}" />
    </Style>
    <Style Selector="Border.bottom">
      <Setter Property="BorderBrush" Value="{StaticResource NightDeep}" />
    </Style>
    <Style Selector="Border.bottom.problem">
      <Setter Property="BorderBrush" Value="{StaticResource Coral}" />
    </Style>
    <Style Selector="Border.path">
      <Setter Property="Background" Value="{StaticResource NightDeep}" />
      <Setter Property="BorderBrush" Value="{StaticResource Stone}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="BorderBrush" Value="{StaticResource Divider}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="Padding" Value="24,20" />
    </Style>
  </Window.Styles>

  <Panel>
    <DockPanel>

      <!-- Titelleiste (Windows-Rahmen ist ausgeblendet). Ziehen verschiebt das Fenster. -->
      <Grid Name="TitleBar" DockPanel.Dock="Top" Height="32" Background="{StaticResource TitleBar}"
            ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <Path Margin="12,0,8,0" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource Gold}" VerticalAlignment="Center"
              Data="M12 2C9 6 4 9 4 13.5A4 4 0 0 0 11 16l-1.5 5h5L13 16a4 4 0 0 0 7-2.5C20 9 15 6 12 2z" />
        <TextBlock Grid.Column="1" Text="Ace of Spades 2" FontSize="12" Foreground="{StaticResource Hint}" VerticalAlignment="Center" />

        <!-- Angemeldeter Spieler. Klick öffnet die Einstellungen (dort: Abmelden). -->
        <Button Grid.Column="2" Theme="{StaticResource TitleBarButton}" Width="NaN" IsVisible="{Binding IsSignedIn}"
                Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Konto" AutomationProperties.Name="Konto">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0">
            <Border Width="18" Height="18" Background="{StaticResource Gold}" BorderBrush="{StaticResource GoldEdge}" BorderThickness="0,0,0,2">
              <TextBlock Text="{Binding AccountInitial}" FontFamily="{StaticResource DisplayFont}" FontSize="11"
                         Foreground="{StaticResource OnGold}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding AccountName}" FontSize="13" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="3" Theme="{StaticResource TitleBarButton}" Classes.active="{Binding IsSettingsOpen}"
                Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Einstellungen" AutomationProperties.Name="Einstellungen">
          <Viewbox Width="16" Height="16">
            <Canvas Width="24" Height="24">
              <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                       Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" />
              <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" StrokeLineCap="Round"
                    Data="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" />
            </Canvas>
          </Viewbox>
        </Button>
        <Button Grid.Column="4" Theme="{StaticResource TitleBarButton}" Click="OnMinimizeClick" AutomationProperties.Name="Minimieren">
          <Path Width="12" Height="12" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" Data="M1 6h10" />
        </Button>
        <Button Grid.Column="5" Theme="{StaticResource TitleBarButton}" Classes="close" Click="OnCloseClick" AutomationProperties.Name="Schließen">
          <Path Width="12" Height="12" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" Data="M1 1l10 10M11 1L1 11" />
        </Button>
      </Grid>

      <!-- Schlachtfeld mit Titel über dem Krater -->
      <Panel DockPanel.Dock="Top" Height="320">
        <c:BattlefieldView Seed="7" />
        <StackPanel HorizontalAlignment="Center" Margin="0,44,0,0" Spacing="10">
          <Panel HorizontalAlignment="Center">
            <TextBlock Text="Ace of Spades 2" FontFamily="{StaticResource DisplayFont}" FontSize="48"
                       Foreground="{StaticResource TitleShadow}" Margin="4,4,0,0" />
            <TextBlock Text="Ace of Spades 2" FontFamily="{StaticResource DisplayFont}" FontSize="48"
                       Foreground="{StaticResource Gold}" Margin="0,0,4,4" />
          </Panel>
          <Panel HorizontalAlignment="Center">
            <TextBlock Text="Blau gegen Grün. Alles ist zerstörbar." FontSize="17" Foreground="{StaticResource TitleBar}" Margin="2,2,0,0" />
            <TextBlock Text="Blau gegen Grün. Alles ist zerstörbar." FontSize="17" Margin="0,0,2,2" />
          </Panel>
        </StackPanel>
      </Panel>

      <!-- Unterer Bereich: je nach Zustand ein anderer Inhalt -->
      <Border Classes="bottom" Classes.problem="{Binding HasProblem}" BorderThickness="0,4,0,0" Padding="40,24,40,26">
        <Panel>

          <!-- Nicht angemeldet: mit Discord anmelden -->
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding IsSignInScreen}">
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="12" Height="12" Background="{StaticResource Gold}" BorderBrush="{StaticResource GoldEdge}" BorderThickness="0,0,2,2" VerticalAlignment="Center" />
                <TextBlock Classes="status" Text="{Binding StatusText}" />
              </StackPanel>
              <TextBlock Classes="detail" Text="{Binding DetailText}" />
              <TextBlock Classes="hint warning" Text="{Binding HintText}" IsVisible="{Binding HintText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <Button Grid.Column="1" Theme="{StaticResource BlockButton}" Classes="primary" Height="64" Padding="28,0" Margin="32,0,0,0"
                    VerticalAlignment="Center" Command="{Binding SignInCommand}" IsDefault="True"
                    AutomationProperties.Name="Mit Discord anmelden">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{StaticResource DiscordLogo}" Fill="{StaticResource OnGold}" Width="26" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="Mit Discord anmelden" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Anmeldung läuft im Browser -->
          <StackPanel Spacing="16" VerticalAlignment="Center" IsVisible="{Binding IsSigningIn}">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel Spacing="6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Data="{StaticResource DiscordLogo}" Fill="{StaticResource Gold}" Width="22" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                  <TextBlock Classes="status" Text="{Binding StatusText}" />
                </StackPanel>
                <TextBlock Classes="detail" Text="{Binding DetailText}" />
              </StackPanel>
              <Button Grid.Column="1" Theme="{StaticResource BlockButton}" Classes="small" Margin="24,0,0,0" VerticalAlignment="Center"
                      Content="Browser erneut öffnen" Command="{Binding ReopenBrowserCommand}" />
              <Button Grid.Column="2" Theme="{StaticResource BlockButton}" Classes="small" Margin="10,0,0,0" VerticalAlignment="Center"
                      Content="Abbrechen" Command="{Binding CancelSignInCommand}" />
            </Grid>
            <c:BlockProgressBar Height="12" Segments="30" IsIndeterminate="True" />
          </StackPanel>

          <!-- Erster Start: Ordner wählen -->
          <StackPanel Spacing="12" VerticalAlignment="Center" IsVisible="{Binding IsChoosingLocation}">
            <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <Border Classes="path" Height="48">
                <TextBlock Text="{Binding GameDirectory}" FontSize="15" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GameDirectory}" />
              </Border>
              <Button Grid.Column="1" Theme="{StaticResource BlockButton}" Margin="10,0,0,0" Command="{Binding ChooseFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Sand}" StrokeThickness="2" VerticalAlignment="Center"
                        Data="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                  <TextBlock Text="Ordner wählen" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Theme="{StaticResource BlockButton}" Classes="primary" Margin="10,0,0,0"
                      Content="Installieren" Command="{Binding InstallCommand}" />
            </Grid>
            <TextBlock Classes="hint" Classes.warning="{Binding HasSpaceProblem}" FontSize="14" Text="{Binding SpaceHint}" />
          </StackPanel>

          <!-- Prüfen, Laden, Verschieben -->
          <StackPanel Spacing="14" VerticalAlignment="Center" IsVisible="{Binding IsWorking}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="15" Foreground="{StaticResource SandMuted}" VerticalAlignment="Bottom" />
            </Grid>
            <c:BlockProgressBar Height="22" Segments="30" Value="{Binding Progress}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
            <Grid ColumnDefinitions="*,Auto" MinHeight="44">
              <TextBlock Classes="hint" FontSize="14" Text="{Binding DetailText}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Theme="{StaticResource BlockButton}" Classes="small" Content="Abbrechen"
                      Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
            </Grid>
          </StackPanel>

          <!-- Bereit -->
          <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center" IsVisible="{Binding IsReady}">
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="12" Height="12" Background="{StaticResource Grass}" BorderBrush="#5F7538" BorderThickness="0,0,2,2" VerticalAlignment="Center" />
                <TextBlock Classes="status" Text="{Binding StatusText}" />
              </StackPanel>
              <TextBlock Classes="detail" Text="{Binding DetailText}" />
              <TextBlock Classes="hint" Text="{Binding GameDirectory}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Theme="{StaticResource BlockButton}" Margin="24,0,0,0" VerticalAlignment="Center"
                    Content="Dateien prüfen" Command="{Binding VerifyCommand}"
                    ToolTip.Tip="Prüft jede Spieldatei und lädt beschädigte neu." />
            <Button Grid.Column="2" Theme="{StaticResource BlockButton}" Classes="primary play" Margin="24,0,0,0" VerticalAlignment="Center"
                    Content="Spielen" Command="{Binding PlayCommand}" IsDefault="True" />
          </Grid>

          <!-- Problem (ggf. mit spielbarer alter Version) -->
          <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center" IsVisible="{Binding HasProblem}">
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource CoralText}" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center"
                      Data="M12 3L2 21h20L12 3zM12 10v5M12 18v.01" />
                <TextBlock Classes="status" Text="{Binding StatusText}" />
              </StackPanel>
              <TextBlock Classes="detail" Text="{Binding DetailText}" />
              <TextBlock Classes="hint" Text="{Binding HintText}" IsVisible="{Binding HintText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <Button Grid.Column="1" Theme="{StaticResource BlockButton}" Margin="24,0,0,0" VerticalAlignment="Center"
                    Command="{Binding RetryCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Sand}" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center"
                      Data="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" />
                <TextBlock Text="Erneut versuchen" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Theme="{StaticResource BlockButton}" Classes="primary play" Margin="24,0,0,0" VerticalAlignment="Center"
                    Content="Spielen" Command="{Binding PlayCommand}" IsVisible="{Binding CanPlayNow}" />
          </Grid>

        </Panel>
      </Border>
    </DockPanel>

    <!-- Einstellungen: Dialog über dem abgedunkelten Fenster -->
    <Panel Margin="0,32,0,0" Background="#B80B0E13" IsVisible="{Binding IsSettingsOpen}">
      <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource Night}" BorderBrush="{StaticResource Stone}" BorderThickness="2,2,2,0">
        <Border BorderBrush="{StaticResource NightDeep}" BorderThickness="0,0,0,6">
          <StackPanel>
            <Border Classes="section" Padding="24,16,12,14">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Einstellungen" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource TitleBarButton}" Width="44" Height="44"
                        Command="{Binding CloseSettingsCommand}" AutomationProperties.Name="Einstellungen schließen">
                  <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" Data="M1 1l10 10M11 1L1 11" />
                </Button>
              </Grid>
            </Border>

            <Border Classes="section" Padding="24,16" IsVisible="{Binding IsSignedIn}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="40" Height="40" Background="{StaticResource Gold}" BorderBrush="{StaticResource GoldEdge}" BorderThickness="0,0,0,3">
                  <TextBlock Text="{Binding AccountInitial}" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                             Foreground="{StaticResource OnGold}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding AccountName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="hint" Text="Angemeldet mit Discord" IsVisible="{Binding !IsAccountOffline}" />
                  <TextBlock Classes="hint warning" Text="Anmeldeserver nicht erreichbar, Anmeldung nicht geprüft" IsVisible="{Binding IsAccountOffline}" />
                </StackPanel>
                <Button Grid.Column="2" Theme="{StaticResource BlockButton}" Classes="small" VerticalAlignment="Center"
                        Content="Abmelden" Command="{Binding SignOutCommand}" />
              </Grid>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="10">
                <TextBlock Text="Spielordner" FontSize="16" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <Border Classes="path" Height="44" Padding="12,0">
                    <TextBlock Text="{Binding GameDirectory}" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GameDirectory}" />
                  </Border>
                  <Button Grid.Column="1" Theme="{StaticResource BlockButton}" Classes="small" Margin="10,0,0,0"
                          Content="Ordner öffnen" Command="{Binding OpenGameFolderCommand}" />
                  <Button Grid.Column="2" Theme="{StaticResource BlockButton}" Classes="small" Margin="10,0,0,0"
                          Content="Verschieben" Command="{Binding MoveGameCommand}" />
                </Grid>
                <TextBlock Classes="hint" Text="Beim Verschieben wandert das installierte Spiel in den neuen Ordner." />
              </StackPanel>
            </Border>

            <Border Classes="section">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="Dateien prüfen" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Classes="hint" Text="Prüft jede Spieldatei und lädt beschädigte neu." />
                </StackPanel>
                <Button Grid.Column="1" Theme="{StaticResource BlockButton}" Classes="small" VerticalAlignment="Center"
                        Content="Jetzt prüfen" Command="{Binding VerifyCommand}" />
              </Grid>
            </Border>

            <Border Classes="section" Padding="24,14">
              <CheckBox IsChecked="{Binding CloseOnGameStart}" FontSize="15" Foreground="{StaticResource Sand}"
                        Content="Launcher schließen, wenn das Spiel startet" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="24" Margin="24,14">
              <TextBlock Classes="hint" Text="{Binding LauncherVersion, StringFormat='Launcher {0}'}" />
              <TextBlock Classes="hint" Text="{Binding InstalledVersion, StringFormat='Spiel {0}'}"
                         IsVisible="{Binding InstalledVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Panel>
  </Panel>
</Window>
