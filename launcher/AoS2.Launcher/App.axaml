<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AoS2.Launcher.App"
             RequestedThemeVariant="Dark">

  <!-- Design „Voxel-Schlachtfeld“: Farben und Bausteine aus dem Stilblatt in Claude Design. -->
  <Application.Resources>
    <FontFamily x:Key="DisplayFont">avares://AoS2.Launcher/Assets/Fonts#Bungee</FontFamily>
    <FontFamily x:Key="BodyFont">avares://AoS2.Launcher/Assets/Fonts#Barlow</FontFamily>

    <SolidColorBrush x:Key="Gold" Color="#F2C14E" />
    <SolidColorBrush x:Key="GoldHover" Color="#F7CF6B" />
    <SolidColorBrush x:Key="GoldPressed" Color="#D9A93A" />
    <SolidColorBrush x:Key="GoldEdge" Color="#A9801F" />
    <SolidColorBrush x:Key="OnGold" Color="#2B1E06" />
    <SolidColorBrush x:Key="TitleShadow" Color="#3A2A12" />
    <SolidColorBrush x:Key="Night" Color="#14181F" />
    <SolidColorBrush x:Key="NightDeep" Color="#0B0E13" />
    <SolidColorBrush x:Key="TitleBar" Color="#0F1218" />
    <SolidColorBrush x:Key="Divider" Color="#1E2430" />
    <SolidColorBrush x:Key="Stone" Color="#2A3240" />
    <SolidColorBrush x:Key="StoneHover" Color="#343E4F" />
    <SolidColorBrush x:Key="StoneEdge" Color="#1A2029" />
    <SolidColorBrush x:Key="Sand" Color="#EDE6D3" />
    <SolidColorBrush x:Key="SandMuted" Color="#C9C2AF" />
    <SolidColorBrush x:Key="Hint" Color="#8B93A3" />
    <SolidColorBrush x:Key="Coral" Color="#E07A5F" />
    <SolidColorBrush x:Key="CoralText" Color="#F0977E" />
    <SolidColorBrush x:Key="Grass" Color="#7E9A4A" />

    <!-- Discord-Logo (Simple Icons, CC0) -->
    <StreamGeometry x:Key="DiscordLogo">M20.317 4.3698 a19.7913 19.7913 0 0 0-4.8851-1.5152 a0.0741 0.0741 0 0 0-0.0785 0.0371 c-0.211 0.3753-0.4447 0.8648-0.6083 1.2495 c-1.8447-0.2762-3.68-0.2762-5.4868 0 c-0.1636-0.3933-0.4058-0.8742-0.6177-1.2495 a0.077 0.077 0 0 0-0.0785-0.037 a19.7363 19.7363 0 0 0-4.8852 1.515 a0.0699 0.0699 0 0 0-0.0321 0.0277 C0.5334 9.0458-0.319 13.5799 0.0992 18.0578 a0.0824 0.0824 0 0 0 0.0312 0.0561 c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294 a0.0777 0.0777 0 0 0 0.0842-0.0276 c0.4616-0.6304 0.8731-1.2952 1.226-1.9942 a0.076 0.076 0 0 0-0.0416-0.1057 c-0.6528-0.2476-1.2743-0.5495-1.8722-0.8923 a0.077 0.077 0 0 1-0.0076-0.1277 c0.1258-0.0943 0.2517-0.1923 0.3718-0.2914 a0.0743 0.0743 0 0 1 0.0776-0.0105 c3.9278 1.7933 8.18 1.7933 12.0614 0 a0.0739 0.0739 0 0 1 0.0785 0.0095 c0.1202 0.099 0.246 0.1981 0.3728 0.2924 a0.077 0.077 0 0 1-0.0066 0.1276 a12.2986 12.2986 0 0 1-1.873 0.8914 a0.0766 0.0766 0 0 0-0.0407 0.1067 c0.3604 0.698 0.7719 1.3628 1.225 1.9932 a0.076 0.076 0 0 0 0.0842 0.0286 c1.961-0.6067 3.9495-1.5219 6.0023-3.0294 a0.077 0.077 0 0 0 0.0313-0.0552 c0.5004-5.177-0.8382-9.6739-3.5485-13.6604 a0.061 0.061 0 0 0-0.0312-0.0286 z M8.02 15.3312 c-1.1825 0-2.1569-1.0857-2.1569-2.419 c0-1.3332 0.9555-2.4189 2.157-2.4189 c1.2108 0 2.1757 1.0952 2.1568 2.419 c0 1.3332-0.9555 2.4189-2.1569 2.4189 z m7.9748 0 c-1.1825 0-2.1569-1.0857-2.1569-2.419 c0-1.3332 0.9554-2.4189 2.1569-2.4189 c1.2108 0 2.1757 1.0952 2.1568 2.419 c0 1.3332-0.946 2.4189-2.1568 2.4189 Z</StreamGeometry>

    <!-- Fluent-Akzent (Checkbox, Fokus) auf Gold umstellen -->
    <Color x:Key="SystemAccentColor">#F2C14E</Color>
    <Color x:Key="SystemAccentColorLight1">#F7CF6B</Color>
    <Color x:Key="SystemAccentColorDark1">#D9A93A</Color>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#2B1E06" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#2B1E06" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#2B1E06" />

    <!-- Buttons sind Blöcke: unten eine dunkle Kante. Beim Drücken wandert sie nach oben, der Block sinkt ein. -->
    <ControlTheme x:Key="BlockButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Stone}" />
      <Setter Property="Foreground" Value="{StaticResource Sand}" />
      <Setter Property="BorderBrush" Value="{StaticResource StoneEdge}" />
      <Setter Property="BorderThickness" Value="0,0,0,4" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Height" Value="48" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Block"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{StaticResource StoneHover}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="BorderThickness" Value="0,4,0,0" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Cursor" Value="Arrow" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#PART_Block">
        <Setter Property="BoxShadow" Value="0 0 0 2 #F2C14E" />
      </Style>

      <!-- Hauptaktion: Gold mit Blockschrift -->
      <Style Selector="^.primary">
        <Setter Property="Background" Value="{StaticResource Gold}" />
        <Setter Property="Foreground" Value="{StaticResource OnGold}" />
        <Setter Property="BorderBrush" Value="{StaticResource GoldEdge}" />
        <Setter Property="BorderThickness" Value="0,0,0,5" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="34,0" />
      </Style>
      <Style Selector="^.primary:pointerover">
        <Setter Property="Background" Value="{StaticResource GoldHover}" />
      </Style>
      <Style Selector="^.primary:pressed">
        <Setter Property="Background" Value="{StaticResource GoldPressed}" />
        <Setter Property="BorderThickness" Value="0,5,0,0" />
      </Style>
      <Style Selector="^.primary:focus-visible /template/ Border#PART_Block">
        <Setter Property="BoxShadow" Value="0 0 0 2 #EDE6D3" />
      </Style>

      <!-- Der große „Spielen“-Block -->
      <Style Selector="^.play">
        <Setter Property="Height" Value="72" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Padding" Value="56,0" />
        <Setter Property="BorderThickness" Value="0,0,0,6" />
      </Style>
      <Style Selector="^.play:pressed">
        <Setter Property="BorderThickness" Value="0,6,0,0" />
      </Style>

      <Style Selector="^.small">
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderThickness" Value="0,0,0,3" />
      </Style>
      <Style Selector="^.small:pressed">
        <Setter Property="BorderThickness" Value="0,3,0,0" />
      </Style>
    </ControlTheme>

    <!-- Knöpfe der eigenen Titelleiste -->
    <ControlTheme x:Key="TitleBarButton" TargetType="Button">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Hint}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Block" Background="{TemplateBinding Background}">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{StaticResource Divider}" />
        <Setter Property="Foreground" Value="{StaticResource Sand}" />
      </Style>
      <Style Selector="^.close:pointerover">
        <Setter Property="Background" Value="#C42B1C" />
        <Setter Property="Foreground" Value="White" />
      </Style>
      <Style Selector="^.active">
        <Setter Property="Background" Value="{StaticResource Divider}" />
        <Setter Property="Foreground" Value="{StaticResource Sand}" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#PART_Block">
        <Setter Property="BoxShadow" Value="inset 0 0 0 2 #F2C14E" />
      </Style>
    </ControlTheme>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

</Application>
