# Only for "npm run dev" on your own PC (docs/backend.md, section 3). No secrets:
# the key below only works with the local backend in the "dev-login" profile.

# Public address of this website
SITE_URL=http://localhost:3000

# Where the website reaches the backend (on the server: internal container name)
BACKEND_INTERNAL_URL=http://localhost:5080

# Key shared with the backend (Backend:InternalKey)
BACKEND_INTERNAL_KEY=nur-zum-entwickeln-kein-geheimnis

# Development login: enter a name instead of using Discord. The backend must run with Discord:UseDevLogin.
AOS2_DEV_LOGIN=true
